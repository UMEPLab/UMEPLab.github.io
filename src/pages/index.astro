---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 获取所有新闻
const allNews = await getCollection('news');

// 按日期排序（最新的在前）
const sortedNews = allNews.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// 在单一时间流中展示全部新闻；不按类别拆分分区。
const latestNews = sortedNews;
---

<Layout
    title="UMEP Lab - Home"
    description="UMEP Lab develops AI-driven models, spatial big-data analysis, and human-centered agents for urban mobility, spatial cognition, sustainable development, smart transportation governance, and mobility equity."
>
    <!-- Main Content Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Hero Section -->
        <div class="bg-gradient-to-br from-slate-50 via-white to-blue-50 rounded-3xl py-8 lg:py-12 mb-12 lg:mb-16 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
            <!-- Hero Section with UMEP Lab Introduction -->
            <section>
                <div class="grid overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl lg:grid-cols-[minmax(19rem,0.78fr)_minmax(0,1.5fr)]">
                    <!-- Left side: Lab Logo -->
                    <div class="order-2 flex items-center justify-center bg-[#fbf7ef] p-6 sm:p-8 lg:order-1 lg:border-r lg:border-slate-200/70 lg:p-10">
                        <img
                            src="/banner.webp"
                            alt="UMEP Lab Logo"
                            width="1024"
                            height="1024"
                            fetchpriority="high"
                            decoding="async"
                            class="aspect-square w-full max-w-md object-contain"
                        />
                    </div>

                    <!-- Right side: Lab Introduction -->
                    <div class="relative order-1 min-h-[34rem] w-full overflow-hidden bg-cover bg-center lg:order-2 lg:min-h-[36rem]"
                         style="background-image: url('/hero.webp');">
                        <!-- A directional overlay keeps the original artwork visible while giving the copy a calm reading area. -->
                        <div class="absolute inset-0 bg-[linear-gradient(100deg,rgba(7,45,63,0.94)_0%,rgba(6,67,82,0.88)_48%,rgba(7,57,69,0.66)_100%)]"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 via-transparent to-cyan-950/10"></div>

                        <div class="relative z-10 flex min-h-[34rem] items-center px-6 py-12 sm:px-10 lg:min-h-[36rem] lg:px-12 xl:px-16">
                            <div class="max-w-3xl text-left text-white">
                                <span class="mb-5 inline-flex rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-50 backdrop-blur-sm sm:text-sm">
                                    Urban mobility · AI · Environment
                                </span>
                                <h1 class="mb-3 text-4xl font-serif font-bold tracking-tight drop-shadow-lg sm:text-5xl xl:text-6xl">UMEP Lab</h1>
                                <h2 class="mb-6 max-w-2xl text-lg font-medium leading-snug text-cyan-50 drop-shadow-md sm:text-xl xl:text-2xl">Urban Mobility and Environmental Perception Laboratory</h2>
                                <div class="mb-7 max-w-2xl space-y-4 text-sm leading-relaxed text-white/90 drop-shadow-sm sm:text-base xl:text-[1.05rem] xl:leading-7">
                                    <p>
                                        Our lab builds on AI-driven modeling technologies, spatial big-data analysis, and human-centered agent design, with a strong focus on urban mobility, environmental perception, and spatial cognition. Through these efforts, we aim to continuously advance sustainable urban and rural development, smart transportation governance, and mobility equity.
                                    </p>
                                    <p>
                                        Our lab’s research focuses on interdisciplinary areas including human mobility, urban science, cognitive maps, built environment perception, AI agents for urban mobility, and serious games. Our agent frameworks integrate LLM agents, reinforcement learning, and rule-based multi-agent simulation to explore the complex interactions among human behavior, the built environment, and environmental sustainability.
                                    </p>
                                </div>
                                <a href="/research" class="inline-flex items-center rounded-xl border border-white/50 bg-white/15 px-6 py-3 text-base font-semibold text-white shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-white/80 hover:bg-white/25 hover:shadow-xl xl:px-7 xl:py-3.5">
                                    Explore Our Research
                                    <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Latest News & Updates -->
        <section id="latest-news" class="mb-12 lg:mb-16 scroll-mt-28">
            <div class="text-center mb-8 lg:mb-12">
                <h2 class="text-3xl lg:text-4xl font-serif font-bold text-primary mb-4 lg:mb-6">Latest News & Updates</h2>

            </div>
            
            <div class="mb-4 flex justify-end gap-2" aria-label="Latest news carousel controls">
                <button
                    id="news-prev"
                    type="button"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 bg-white text-primary shadow-sm transition-colors hover:border-primary hover:bg-primary/5 disabled:cursor-not-allowed disabled:opacity-30"
                    aria-label="Scroll latest news left"
                    aria-controls="news-scroller"
                >
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>
                <button
                    id="news-autoplay"
                    type="button"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 bg-white text-primary shadow-sm transition-colors hover:border-primary hover:bg-primary/5 disabled:cursor-not-allowed disabled:opacity-30"
                    aria-label="Pause automatic news scrolling"
                    aria-controls="news-scroller"
                >
                    <svg id="news-pause-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6"></path>
                    </svg>
                    <svg id="news-play-icon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7l8 5-8 5V7z"></path>
                    </svg>
                </button>
                <button
                    id="news-next"
                    type="button"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 bg-white text-primary shadow-sm transition-colors hover:border-primary hover:bg-primary/5 disabled:cursor-not-allowed disabled:opacity-30"
                    aria-label="Scroll latest news right"
                    aria-controls="news-scroller"
                >
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>

            <!-- Two identical groups create a seamless, single-row infinite loop -->
            <div
                id="news-scroller"
                class="news-scroller flex flex-nowrap overflow-x-auto pb-5"
                role="region"
                aria-roledescription="carousel"
                aria-label="Latest news updates"
                tabindex="0"
            >
                {[false, true].map((duplicate) => (
                    <div
                        class="news-loop-group flex flex-none items-stretch gap-6 pr-6"
                        role={duplicate ? undefined : 'list'}
                        aria-label={duplicate ? undefined : 'Latest news updates'}
                        aria-hidden={duplicate ? 'true' : undefined}
                    >
                        {latestNews.map((news) => (
                            <article role={duplicate ? undefined : 'listitem'} class="w-[86vw] max-w-sm flex-none bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-all duration-300 sm:w-[22rem] lg:w-[23rem] xl:w-96">
                                <a
                                    href={`/news/${news.slug}/`}
                                    class="group flex h-full flex-col"
                                    aria-label={`Read ${news.data.title}`}
                                    tabindex={duplicate ? -1 : undefined}
                                >
                                    {(news.data.thumbnail || news.data.image) && (
                                        <div class="aspect-video overflow-hidden bg-gray-100">
                                            <img
                                                src={news.data.thumbnail ?? news.data.image}
                                                alt={news.data.title}
                                                width={news.data.thumbnailWidth ?? news.data.imageWidth}
                                                height={news.data.thumbnailHeight ?? news.data.imageHeight}
                                                loading="lazy"
                                                decoding="async"
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                            />
                                        </div>
                                    )}

                                    <div class="p-6 flex flex-1 flex-col">
                                        <div class="flex flex-wrap items-center gap-3 mb-4">
                                            <span class="inline-block px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full">
                                                {news.data.category}
                                            </span>
                                            <time datetime={news.data.date.toISOString()} class="text-sm text-gray-500">
                                                {new Date(news.data.date).toLocaleDateString('en-US', {
                                                    year: 'numeric',
                                                    month: 'short',
                                                    day: 'numeric'
                                                })}
                                            </time>
                                        </div>

                                        <h3 class="text-xl font-serif font-bold mb-3 text-gray-900 group-hover:text-primary transition-colors">
                                            {news.data.title}
                                        </h3>

                                        <p class="text-gray-700 mb-4 line-clamp-6">
                                            {news.data.summary}
                                        </p>
                                        <span class="mt-auto inline-flex items-center text-sm font-semibold text-primary">
                                            Read update
                                            <span aria-hidden="true" class="ml-1">→</span>
                                        </span>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>
                ))}
            </div>
            
            <!-- View All News Archive Link -->
            <div class="text-center mt-8">
                <p class="text-gray-500 mb-4">
                    All news updates are displayed here as quick reports
                </p>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="mb-12 lg:mb-16">
            <div class="bg-gradient-to-br from-gray-50 via-white to-blue-50 rounded-2xl lg:rounded-3xl p-8 lg:p-16 text-center border border-gray-100 shadow-xl">
                <h2 class="text-2xl lg:text-3xl xl:text-4xl font-serif font-bold text-primary mb-4 lg:mb-6"> Get to Know Us</h2>
                <div class="flex flex-col sm:flex-row gap-4 lg:gap-6 justify-center max-w-2xl mx-auto">
                    <a 
                        href="/people" 
                        class="flex-1 inline-flex items-center justify-center px-6 lg:px-8 py-3 lg:py-4 border-2 border-primary text-primary rounded-xl hover:bg-primary hover:text-white transition-all duration-300 font-semibold text-base lg:text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1"
                    >
                        Meet Our Lab Members
                        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                        </svg>
                    </a>
                    <a 
                        href="/openings" 
                        class="flex-1 inline-flex items-center justify-center px-6 lg:px-8 py-3 lg:py-4 bg-primary text-white rounded-xl hover:bg-blue-800 transition-all duration-300 font-semibold text-base lg:text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1"
                    >
                        View Open Positions
                        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6M8 6a2 2 0 012-2h4a2 2 0 012 2v6a2 2 0 01-2 2H10a2 2 0 01-2-2V6z"></path>
                        </svg>
                    </a>

                </div>
            </div>
        </section>
    </div>
</Layout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-6 {
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .news-scroller {
        scrollbar-width: none;
        overscroll-behavior-inline: contain;
        -webkit-overflow-scrolling: touch;
    }

    .news-scroller::-webkit-scrollbar {
        display: none;
    }
    
    /* Enhanced shadow utilities */
    .shadow-3xl {
        box-shadow: 0 35px 60px -12px rgba(0, 0, 0, 0.25);
    }
    
    /* Hero section background animations */
    @keyframes float {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
            opacity: 0.1;
        }
        50% {
            transform: translateY(-10px) rotate(180deg);
            opacity: 0.2;
        }
    }
    
    @keyframes pulse-slow {
        0%, 100% {
            opacity: 0.05;
            transform: scale(1);
        }
        50% {
            opacity: 0.15;
            transform: scale(1.1);
        }
    }
    
    /* Hero区域的额外视觉效果 */
    .hero-pattern::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: 
            radial-gradient(circle at 20% 80%, rgba(255,255,255,0.05) 2px, transparent 2px),
            radial-gradient(circle at 80% 20%, rgba(255,255,255,0.05) 2px, transparent 2px),
            radial-gradient(circle at 40% 40%, rgba(255,255,255,0.03) 2px, transparent 2px);
        background-size: 50px 50px, 60px 60px, 40px 40px;
        animation: float 20s ease-in-out infinite;
    }
    
    /* Smooth transitions for interactive elements */
    .transform {
        transition: transform 0.3s ease-in-out;
    }
    
    /* Enhanced button hover effects */
    .hover\:-translate-y-1:hover {
        transform: translateY(-0.25rem);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const newsScroller = document.getElementById('news-scroller');
        const previousButton = document.getElementById('news-prev') as HTMLButtonElement | null;
        const nextButton = document.getElementById('news-next') as HTMLButtonElement | null;
        const autoplayButton = document.getElementById('news-autoplay') as HTMLButtonElement | null;
        const pauseIcon = document.getElementById('news-pause-icon');
        const playIcon = document.getElementById('news-play-icon');

        if (!newsScroller || !previousButton || !nextButton || !autoplayButton || !pauseIcon || !playIcon) return;

        const firstLoopGroup = newsScroller.querySelector<HTMLElement>('.news-loop-group');
        if (!firstLoopGroup) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const scrollSpeed = 32;
        let manuallyPaused = reducedMotion.matches;
        let pointerInside = false;
        let focusInside = false;
        let touchInteracting = false;
        let touchResumeTimer: number | undefined;
        let lastFrameTime = 0;

        const getLoopWidth = () => firstLoopGroup.getBoundingClientRect().width;

        const getScrollStep = () => {
            const firstCard = firstLoopGroup.querySelector<HTMLElement>('article');
            if (!firstCard) return Math.min(newsScroller.clientWidth * 0.9, 420);

            const groupStyles = window.getComputedStyle(firstLoopGroup);
            const gap = Number.parseFloat(groupStyles.columnGap || groupStyles.gap || '0') || 0;
            return firstCard.getBoundingClientRect().width + gap;
        };

        const updateControls = () => {
            const hasOverflow = newsScroller.scrollWidth - newsScroller.clientWidth > 2;
            previousButton.disabled = !hasOverflow;
            nextButton.disabled = !hasOverflow;
            autoplayButton.disabled = !hasOverflow;
        };

        const normalizeLoopPosition = () => {
            const loopWidth = getLoopWidth();
            if (loopWidth <= 0) return;

            while (newsScroller.scrollLeft >= loopWidth) {
                newsScroller.scrollLeft -= loopWidth;
            }
        };

        const scrollNews = (direction: -1 | 1) => {
            const loopWidth = getLoopWidth();
            if (loopWidth <= 0) return;

            const step = getScrollStep();
            if (direction === -1 && newsScroller.scrollLeft < step) {
                newsScroller.scrollLeft += loopWidth;
            }

            newsScroller.scrollBy({ left: direction * step, behavior: 'smooth' });
            window.setTimeout(normalizeLoopPosition, 500);
        };

        const canAnimate = () => (
            !manuallyPaused &&
            !pointerInside &&
            !focusInside &&
            !touchInteracting &&
            !document.hidden &&
            newsScroller.scrollWidth - newsScroller.clientWidth > 2
        );

        const animate = (timestamp: number) => {
            if (!lastFrameTime) lastFrameTime = timestamp;
            const elapsed = Math.min(timestamp - lastFrameTime, 64);
            lastFrameTime = timestamp;

            if (canAnimate()) {
                newsScroller.scrollLeft += (scrollSpeed * elapsed) / 1000;
                normalizeLoopPosition();
            }

            window.requestAnimationFrame(animate);
        };

        const updateAutoplayControl = () => {
            pauseIcon.classList.toggle('hidden', manuallyPaused);
            playIcon.classList.toggle('hidden', !manuallyPaused);
            autoplayButton.setAttribute(
                'aria-label',
                manuallyPaused ? 'Start automatic news scrolling' : 'Pause automatic news scrolling'
            );
        };

        previousButton.addEventListener('click', () => scrollNews(-1));
        nextButton.addEventListener('click', () => scrollNews(1));
        autoplayButton.addEventListener('click', () => {
            manuallyPaused = !manuallyPaused;
            updateAutoplayControl();
        });
        newsScroller.addEventListener('mouseenter', () => {
            pointerInside = true;
        });
        newsScroller.addEventListener('mouseleave', () => {
            pointerInside = false;
        });
        newsScroller.addEventListener('focusin', () => {
            focusInside = true;
        });
        newsScroller.addEventListener('focusout', (event) => {
            if (!newsScroller.contains(event.relatedTarget as Node | null)) {
                focusInside = false;
            }
        });
        newsScroller.addEventListener('pointerdown', (event) => {
            if (event.pointerType === 'mouse') return;
            touchInteracting = true;
            if (touchResumeTimer !== undefined) window.clearTimeout(touchResumeTimer);
        });
        const resumeAfterTouch = () => {
            if (touchResumeTimer !== undefined) window.clearTimeout(touchResumeTimer);
            touchResumeTimer = window.setTimeout(() => {
                touchInteracting = false;
            }, 1200);
        };
        newsScroller.addEventListener('pointerup', resumeAfterTouch);
        newsScroller.addEventListener('pointercancel', resumeAfterTouch);
        reducedMotion.addEventListener('change', (event) => {
            manuallyPaused = event.matches;
            updateAutoplayControl();
        });
        window.addEventListener('resize', () => {
            updateControls();
            normalizeLoopPosition();
        });
        updateControls();
        updateAutoplayControl();
        window.requestAnimationFrame(animate);
    });
</script>
