---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const imagePath = entry.data.image
  ? entry.data.image.startsWith('/') ? entry.data.image : `/${entry.data.image}`
  : undefined;
---

<Layout
  title={entry.data.title}
  description={entry.data.summary}
  image={imagePath}
  type="article"
>
  <div class="container mx-auto px-4 py-8">
    <article class="max-w-4xl mx-auto">
      <a href="/#latest-news" class="mb-6 inline-flex items-center text-sm font-semibold text-primary hover:underline">
        <span aria-hidden="true" class="mr-2">←</span>
        Back to latest news
      </a>

      <header class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{entry.data.title}</h1>
        <div class="flex items-center text-gray-600 mb-4">
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          {entry.data.category && (
            <span class="ml-4 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
              {entry.data.category}
            </span>
          )}
        </div>
        {entry.data.summary && (
          <p class="text-xl text-gray-700 leading-relaxed">{entry.data.summary}</p>
        )}
      </header>
      
      {imagePath && (
        <div class="mb-8">
          <img 
            src={imagePath}
            alt={entry.data.title}
            width={entry.data.imageWidth}
            height={entry.data.imageHeight}
            decoding="async"
            class="w-full h-auto rounded-lg shadow-lg"
          />
        </div>
      )}
      
      <div class="prose prose-lg max-w-none news-content">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<style>
  .news-content :global(.news-gallery) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
  }

  .news-content :global(.news-gallery figure) {
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(226 232 240);
    border-radius: 0.75rem;
    background: white;
    box-shadow: 0 8px 24px rgb(15 23 42 / 0.08);
  }

  .news-content :global(.news-gallery--single) {
    grid-template-columns: minmax(0, 42rem);
    justify-content: center;
  }

  .news-content :global(.news-gallery img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    border-radius: 0;
    object-fit: cover;
  }

  .news-content :global(.news-gallery figcaption) {
    margin: 0;
    padding: 0.75rem 1rem;
    color: rgb(71 85 105);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .news-content :global(.news-gallery) {
      grid-template-columns: 1fr;
    }
  }
</style>
