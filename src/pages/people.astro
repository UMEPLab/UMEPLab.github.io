---
import Layout from '../layouts/Layout.astro';

interface RPGStudent {
    name: string;
    degree: 'PHD' | 'MPHIL';
    programme: string;
    coSupervised?: boolean;
    completionYear?: string;
}

interface ResearchAssistant {
    name: string;
}

const director = {
    name: "Dr. Qiumeng Li",
    title: "Lab Director & Assistant Professor",
    email: "qiumengli@hkust-gz.edu.cn",
    researchInterest: "Research Interests: Built Environment Cognition for Mobility, AI Agent for Behavioural Geography"
};

const currentRPGs: RPGStudent[] = [
    { name: "Chunhou Ji", degree: "PHD", programme: "Urban Governance and Design" },
    { name: "Xiao Zhang", degree: "PHD", programme: "Intelligent Transportation", coSupervised: true },
    { name: "Pei Sun", degree: "PHD", programme: "Intelligent Transportation" },
    { name: "Xiao Yang", degree: "PHD", programme: "Urban Governance and Design" },
    { name: "Xinyue Liu", degree: "PHD", programme: "Urban Governance and Design" },
    { name: "Ruoyu Yao", degree: "PHD", programme: "Robotics and Autonomous Systems", coSupervised: true },
    { name: "Xinxi Yang", degree: "PHD", programme: "Intelligent Transportation" },
    { name: "Houjie Chen", degree: "MPHIL", programme: "Urban Governance and Design" },
    { name: "Xinrui Zhu", degree: "MPHIL", programme: "Intelligent Transportation" },
    { name: "Jinglan Chen", degree: "MPHIL", programme: "Intelligent Transportation" },
    { name: "Kaixiang Zhang", degree: "MPHIL", programme: "Urban Governance and Design", coSupervised: true }
];

const graduatedRPGs: RPGStudent[] = [
    {
        name: "Xinxi Yang",
        degree: "MPHIL",
        programme: "Intelligent Transportation",
        completionYear: "2024–2025"
    }
];

const researchAssistants: ResearchAssistant[] = [
    { name: "Shanbo Qi" },
    { name: "Qingyuan Xu" },
    { name: "Jinru Pan" }
];

const degreeGroups = [
    { key: "PHD", label: "Doctor of Philosophy", shortLabel: "PhD" },
    { key: "MPHIL", label: "Master of Philosophy", shortLabel: "MPhil" }
] as const;

const supervisionPanels = [
    { id: "current-rpgs", tabId: "current-rpgs-tab", label: "Current RPGs", students: currentRPGs },
    { id: "graduated-rpgs", tabId: "graduated-rpgs-tab", label: "Graduated RPGs", students: graduatedRPGs }
].map((panel) => ({
    ...panel,
    groups: degreeGroups
        .map((degree) => ({
            ...degree,
            students: panel.students.filter((student) => student.degree === degree.key)
        }))
        .filter((group) => group.students.length > 0)
}));

const initials = (name: string) => name.split(' ').map((part) => part[0]).join('');
---

<Layout
    title="People"
    description="Meet the UMEP Lab director, research assistants, and current and graduated research postgraduates working across urban governance, intelligent transportation, and autonomous systems."
>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <header class="mx-auto mb-12 max-w-3xl text-center">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary-600">People</p>
            <h1 class="text-4xl font-serif font-bold text-gray-950 sm:text-5xl">Our Team</h1>
            <p class="mt-4 text-base leading-relaxed text-gray-600 sm:text-lg">
                Lab leadership, research assistants, and research postgraduate supervision across our interdisciplinary programmes.
            </p>
        </header>

        <section class="mb-14" aria-labelledby="director-heading">
            <div class="mb-6 flex items-center gap-4">
                <h2 id="director-heading" class="shrink-0 text-2xl font-serif font-bold text-gray-950">Lab Director</h2>
                <div class="h-px flex-1 bg-gradient-to-r from-primary-200 to-transparent"></div>
            </div>

            <article class="overflow-hidden rounded-2xl border border-white/80 bg-white/80 shadow-lg shadow-blue-950/5 backdrop-blur-sm">
                <div class="grid md:grid-cols-[auto_1fr]">
                    <div class="flex items-center justify-center bg-gradient-to-br from-primary-600 to-accent-500 p-8 md:w-48">
                        <div class="flex h-24 w-24 items-center justify-center rounded-full border border-white/40 bg-white/15 text-3xl font-bold text-white shadow-inner">
                            QL
                        </div>
                    </div>
                    <div class="p-6 sm:p-8">
                        <p class="mb-2 text-sm font-semibold uppercase tracking-[0.14em] text-primary-600">{director.title}</p>
                        <h3 class="mb-3 text-2xl font-serif font-bold text-gray-950 sm:text-3xl">{director.name}</h3>
                        <p class="max-w-3xl leading-relaxed text-gray-600">{director.researchInterest}</p>
                        <a
                            href={`mailto:${director.email}`}
                            class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-700 transition-colors hover:text-primary-900 hover:underline"
                        >
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-16 11h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            {director.email}
                        </a>
                    </div>
                </div>
            </article>
        </section>

        <section aria-labelledby="rpg-supervision-heading">
            <div class="mb-6">
                <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-primary-600">Supervision</p>
                <h2 id="rpg-supervision-heading" class="text-3xl font-serif font-bold text-gray-950 sm:text-4xl">
                    Research Postgraduate (RPG) Supervision
                </h2>
                <p class="mt-3 max-w-3xl leading-relaxed text-gray-600">
                    Current and graduated research postgraduates, grouped by degree programme and supervision role.
                </p>
            </div>

            <div class="overflow-hidden rounded-2xl border border-white/80 bg-white/75 shadow-xl shadow-blue-950/5 backdrop-blur-sm">
                <div class="border-b border-gray-200 bg-slate-50/80 p-3 sm:p-4">
                    <div class="grid grid-cols-2 gap-2" role="tablist" aria-label="Research postgraduate supervision status">
                        {supervisionPanels.map((panel, index) => (
                            <button
                                id={panel.tabId}
                                type="button"
                                class="rpg-tab"
                                role="tab"
                                aria-selected={index === 0 ? "true" : "false"}
                                aria-controls={panel.id}
                                tabindex={index === 0 ? 0 : -1}
                                data-rpg-tab={panel.id}
                            >
                                <span>{panel.label}</span>
                                <span class="rpg-count">{panel.students.length}</span>
                            </button>
                        ))}
                    </div>
                </div>

                {supervisionPanels.map((panel, panelIndex) => (
                    <div
                        id={panel.id}
                        class="space-y-10 p-5 sm:p-8"
                        role="tabpanel"
                        aria-labelledby={panel.tabId}
                        hidden={panelIndex !== 0}
                        data-rpg-panel
                    >
                        {panel.groups.map((group) => (
                            <section aria-labelledby={`${panel.id}-${group.key.toLowerCase()}`}>
                                <div class="mb-5 flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 pb-3">
                                    <div>
                                        <h3 id={`${panel.id}-${group.key.toLowerCase()}`} class="text-xl font-serif font-bold text-gray-950 sm:text-2xl">
                                            {group.label}
                                        </h3>
                                        <p class="mt-1 text-sm text-gray-500">{group.shortLabel} researchers</p>
                                    </div>
                                    <span class="rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-700">
                                        {group.students.length} {group.students.length === 1 ? 'researcher' : 'researchers'}
                                    </span>
                                </div>

                                {group.students.length > 0 ? (
                                    <div class="grid gap-4 md:grid-cols-2">
                                        {group.students.map((student) => (
                                            <article class="group rounded-xl border border-gray-200 bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-lg hover:shadow-primary-900/5">
                                                <div class="flex items-start gap-4">
                                                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-primary-100 to-accent-100 text-sm font-bold text-primary-700 ring-4 ring-primary-50">
                                                        {initials(student.name)}
                                                    </div>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="flex flex-wrap items-center gap-2">
                                                            <h4 class="text-lg font-bold text-gray-950">{student.name}</h4>
                                                            {student.coSupervised && (
                                                                <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800 ring-1 ring-inset ring-amber-200">
                                                                    Co-supervision
                                                                </span>
                                                            )}
                                                        </div>
                                                        <p class="mt-2 text-sm leading-relaxed text-gray-600">{student.programme}</p>
                                                        {student.completionYear && (
                                                            <p class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
                                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z" />
                                                                </svg>
                                                                Completed in Academic Year {student.completionYear}
                                                            </p>
                                                        )}
                                                    </div>
                                                </div>
                                            </article>
                                        ))}
                                    </div>
                                ) : (
                                    <div class="rounded-xl border border-dashed border-gray-300 bg-slate-50/70 px-5 py-8 text-center text-sm text-gray-500">
                                        No graduated {group.shortLabel} researchers are listed.
                                    </div>
                                )}
                            </section>
                        ))}
                    </div>
                ))}
            </div>
        </section>

        <section class="mt-14" aria-labelledby="research-assistants-heading">
            <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-primary-600">Research Team</p>
                    <h2 id="research-assistants-heading" class="text-3xl font-serif font-bold text-gray-950 sm:text-4xl">
                        Research Assistants
                    </h2>
                </div>
                <span class="rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-700">
                    {researchAssistants.length} research assistants
                </span>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {researchAssistants.map((assistant) => (
                    <article class="group rounded-xl border border-gray-200 bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-lg hover:shadow-primary-900/5">
                        <div class="flex items-center gap-4">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-primary-100 to-accent-100 text-sm font-bold text-primary-700 ring-4 ring-primary-50">
                                {initials(assistant.name)}
                            </div>
                            <div class="min-w-0 flex-1">
                                <h3 class="text-lg font-bold text-gray-950">{assistant.name}</h3>
                                <p class="mt-1 text-sm text-gray-600">Research Assistant</p>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </div>
</Layout>

<script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-rpg-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-rpg-panel]'));

    const selectTab = (selectedTab: HTMLButtonElement) => {
        const selectedPanelId = selectedTab.getAttribute('data-rpg-tab');

        tabs.forEach((tab) => {
            const isSelected = tab === selectedTab;
            tab.setAttribute('aria-selected', String(isSelected));
            tab.setAttribute('tabindex', isSelected ? '0' : '-1');
        });

        panels.forEach((panel) => {
            panel.toggleAttribute('hidden', panel.id !== selectedPanelId);
        });
    };

    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;

            event.preventDefault();
            let nextIndex = index;

            if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
            if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
            if (event.key === 'Home') nextIndex = 0;
            if (event.key === 'End') nextIndex = tabs.length - 1;

            const nextTab = tabs[nextIndex];
            selectTab(nextTab);
            nextTab.focus();
        });
    });
</script>

<style>
    .rpg-tab {
        display: inline-flex;
        min-height: 3rem;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        border-radius: 0.75rem;
        padding: 0.65rem 0.85rem;
        color: #475569;
        font-size: 0.875rem;
        font-weight: 700;
        transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
    }

    .rpg-tab:hover {
        background: rgba(219, 234, 254, 0.7);
        color: #1d4ed8;
    }

    .rpg-tab[aria-selected="true"] {
        background: #ffffff;
        color: #1d4ed8;
        box-shadow: 0 7px 20px rgba(30, 64, 175, 0.1);
    }

    .rpg-count {
        display: inline-flex;
        min-width: 1.65rem;
        height: 1.65rem;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        background: #dbeafe;
        padding: 0 0.4rem;
        color: #1d4ed8;
        font-size: 0.75rem;
    }

    .rpg-tab[aria-selected="true"] .rpg-count {
        background: #2563eb;
        color: #ffffff;
    }

    [data-rpg-panel][hidden] {
        display: none;
    }

    @media (min-width: 640px) {
        .rpg-tab {
            padding-inline: 1.25rem;
            font-size: 0.9375rem;
        }
    }
</style>
